---
import '../styles/global.css';
import Fonts from '../components/Fonts.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { config } from '../config';
import { dirOf, localizedPath, useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Keep the page out of search results (thank-you, 404). */
  noindex?: boolean;
  /** Output canonical and hreflang tags. Off for the 404 page, which has no real URL. */
  alternates?: boolean;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  /** Override the language switch target (the 404 page has no Arabic twin). */
  altHref?: string;
}

const { lang, title, description, noindex = false, alternates = true, schema = [], altHref } = Astro.props;
const t = useTranslations(lang);
const dir = dirOf(lang);
const site = config.siteUrl;
const path = Astro.url.pathname;
const abs = (p: string) => new URL(p, site).href;

const canonical = abs(path);
const enUrl = abs(localizedPath(path, 'en'));
const arUrl = abs(localizedPath(path, 'ar'));
const ogImage = abs('/og-image.png');

const phoneConfirmed = !/X/i.test(config.phoneDisplay);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'BRUMA',
  url: `${site}/`,
  logo: { '@type': 'ImageObject', url: abs('/icon-512.png'), width: 512, height: 512 },
  email: config.email,
  ...(phoneConfirmed ? { telephone: config.phoneDisplay.replace(/\s+/g, '') } : {}),
  areaServed: { '@type': 'Country', name: 'Kuwait' },
  knowsLanguage: ['en', 'ar'],
};
const jsonLd = noindex ? schema : [organization, ...schema];
---

<!doctype html>
<html lang={lang} dir={dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <Fonts lang={lang} />

    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      alternates && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="en" href={enUrl} />
          <link rel="alternate" hreflang="ar" href={arUrl} />
          <link rel="alternate" hreflang="x-default" href={enUrl} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BRUMA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {alternates && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AR'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F3EFE8" />
    <meta name="format-detection" content="telephone=no" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    {
      /* Analytics slot: a cookieless script, off while analyticsId is empty. */
      config.analyticsId && (
        <script is:inline defer src={config.analyticsScriptSrc} data-website-id={config.analyticsId} data-do-not-track="true" />
      )
    }
  </head>
  <body>
    <div class="scroll-sentinel" data-scroll-sentinel aria-hidden="true"></div>
    <a href="#main" class="skip-link sr-only-focusable btn btn-primary">{t.skipLink}</a>
    <Header lang={lang} altHref={altHref} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} altHref={altHref} />
    <WhatsAppFloat lang={lang} />

    <script>
      import { initClickTracking } from '../scripts/analytics';
      import { captureLeadParams } from '../scripts/lead';
      import { initReveal } from '../scripts/reveal';

      captureLeadParams();
      initClickTracking();
      initReveal();
    </script>
  </body>
</html>

<style>
  .scroll-sentinel {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    width: 1px;
    height: 8px;
    pointer-events: none;
  }
  .skip-link {
    position: fixed;
    top: 8px;
    inset-inline-start: 8px;
    z-index: 100;
  }
  main:focus {
    outline: none;
  }
</style>
