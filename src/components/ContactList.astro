---
// WhatsApp, phone and email as links, for light backgrounds (the footer has its own carbon version).
import Icon from './Icon.astro';
import { config, phoneHref, whatsappLink } from '../config';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Sent with the whatsapp_click analytics event. */
  trackLocation: string;
}
const { lang, trackLocation } = Astro.props;
const t = useTranslations(lang);
---

<ul class="contact-list">
  <li>
    <a
      href={whatsappLink(t.whatsapp.floatMessage)}
      class="contact-link"
      target="_blank"
      rel="noopener"
      data-track="whatsapp_click"
      data-track-location={trackLocation}
    >
      <Icon name="whatsapp" size={20} />
      <span>{t.footer.whatsapp}</span>
    </a>
  </li>
  <li>
    <a href={phoneHref} class="contact-link">
      <Icon name="phone" size={20} />
      <span class="sr-only">{t.footer.phone}: </span><span class="ltr phone">{config.phoneDisplay}</span>
    </a>
  </li>
  {
    config.email && (
      <li>
        <a href={`mailto:${config.email}`} class="contact-link">
          <Icon name="mail" size={20} />
          <span class="sr-only">{t.footer.email}: </span>
          <span class="ltr">{config.email}</span>
        </a>
      </li>
    )
  }
</ul>

<style>
  .contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: var(--color-deep-teal);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .contact-link:hover {
    text-decoration-thickness: 2px;
  }
  .contact-link :global(svg) {
    flex-shrink: 0;
    color: var(--color-carbon);
  }
  /* A long email wraps instead of widening the page. */
  .contact-link {
    max-width: 100%;
  }
  .contact-link .ltr {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
