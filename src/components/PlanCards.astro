---
// The two ways to own it (monthly plan, pay upfront) as cards, with the upfront-saving badge while
// flags.showUpfrontSaving is on. Used on the homepage and on /ways-to-own/. motion.ts finds the grid
// by [data-plans]: the cards rise in and the monthly card's vapor outline traces in once.
import Icon from './Icon.astro';
import PriceDisplay from './PriceDisplay.astro';
import { config } from '../config';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Heading level of the card titles: 3 under a section heading, 2 directly under the page H1. */
  level?: 2 | 3;
}
const { lang, level = 3 } = Astro.props;
const t = useTranslations(lang);
const Heading = level === 2 ? 'h2' : 'h3';
const showSaving = config.flags.showUpfrontSaving;
const plans = [
  { ...t.ways.monthly, featured: true, id: 'plan-monthly' },
  { ...t.ways.upfront, featured: false, id: 'plan-upfront' },
];
---

<div class="ways-grid" data-plans>
  {
    plans.map((plan) => (
      <article
        class:list={['card', 'plan', { 'plan-featured': plan.featured }]}
        aria-labelledby={plan.id}
        data-motion
        data-trace={plan.featured ? '' : undefined}
      >
        <div class="plan-head">
          <Heading id={plan.id} class="plan-title">
            {plan.title}
          </Heading>
          {showSaving && !plan.featured && <span class="save-pill">{t.upfrontSaving.badge}</span>}
        </div>
        <div class="plan-price-block">
          <PriceDisplay text={plan.price} class="plan-price" />
          {showSaving && !plan.featured && <p class="plan-price-note">{t.upfrontSaving.note}</p>}
        </div>
        <ul class="plan-list">
          {plan.bullets.map((b) => (
            <li>
              <Icon name="check" size={20} class="plan-check" />
              <span>{b}</span>
            </li>
          ))}
        </ul>
        {plan.small && <p class="plan-small">{plan.small}</p>}
      </article>
    ))
  }
</div>

<style>
  .ways-grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .ways-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
  .plan {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px 24px;
    color: var(--color-carbon);
  }
  @media (min-width: 1024px) {
    .plan {
      padding: 48px;
    }
  }
  /* Card titles keep the H3 size even when they're H2s (directly under the page H1). */
  .plan-title {
    font-size: calc(var(--fs-h3) * var(--script-scale));
    letter-spacing: -0.01em;
  }
  /* Monthly plan: 2px vapor outline (requested in the phase brief). motion.ts traces it in once. */
  .plan-featured {
    border: 2px solid var(--color-vapor);
  }
  .plan-featured:global(.trace-pending) {
    border-color: transparent;
  }
  .plan :global(.plan-trace) {
    position: absolute;
    top: -2px;
    inset-inline-start: -2px;
    overflow: visible;
    pointer-events: none;
    color: var(--color-vapor);
  }
  .plan :global(.plan-trace:dir(rtl)) {
    transform: scaleX(-1);
  }
  /* The price leads each card: a display numeral, or the plain line when there's no number. */
  .plan-price-block {
    padding-block: 8px 24px;
    border-bottom: 1px solid var(--color-line);
  }
  .plan-price-block :global(.price-display-text) {
    min-height: 1.5em;
  }
  .plan-price-note {
    margin-block-start: 12px;
    color: var(--color-stone);
    font-size: calc(var(--fs-small) * var(--script-scale));
  }
  /* Title and saving badge share one row (the badge wraps under the title on narrow cards), so
     both card titles line up side by side. */
  .plan-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    min-height: 2em;
  }
  .plan-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .plan-list li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }
  .plan-list :global(.plan-check) {
    flex-shrink: 0;
    margin-block-start: 3px;
  }
  .plan-small {
    margin-block-start: auto;
    padding-block-start: 8px;
    color: var(--color-stone);
    font-size: calc(var(--fs-small) * var(--script-scale));
  }
</style>
