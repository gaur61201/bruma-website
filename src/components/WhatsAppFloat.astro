---
import Icon from './Icon.astro';
import { whatsappLink } from '../config';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<a
  href={whatsappLink(t.whatsapp.floatMessage)}
  class="wa-float"
  aria-label={t.whatsapp.floatLabel}
  target="_blank"
  rel="noopener"
  data-wa-float
  data-track="whatsapp_click"
  data-track-location="float"
>
  <Icon name="whatsapp" size={28} />
</a>

<script>
  // Hide the floating button while the demo form is on screen: the form has its own WhatsApp option.
  const btn = document.querySelector<HTMLElement>('[data-wa-float]');
  const demo = document.getElementById('demo');
  if (btn && demo && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      btn.toggleAttribute('data-hidden', entry.isIntersecting);
    }).observe(demo);
  }
</script>

<style>
  /* 56px green circle, bottom on the inline-end side: bottom-right in English, bottom-left in Arabic. */
  .wa-float {
    position: fixed;
    bottom: calc(16px + env(safe-area-inset-bottom));
    inset-inline-end: 16px;
    z-index: 30;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-whatsapp);
    color: var(--color-white);
    transition:
      opacity 200ms var(--ease-out),
      visibility 200ms var(--ease-out),
      transform 200ms var(--ease-out),
      scale 160ms var(--ease-out);
  }
  /* Hover grows it a touch (pointer devices only); a press shrinks it. Separate from the transform
     used by the pop-in and the hide-over-the-form states. */
  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) and (pointer: fine) {
      .wa-float:hover {
        scale: 1.05;
      }
    }
    .wa-float:active {
      scale: 0.95;
    }
  }
  .wa-float:focus-visible {
    outline-offset: 4px;
    border-radius: 50%;
  }
  .wa-float[data-hidden] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
  }
  /* Pops in from 0.6 after 1s. "backwards" fill, so afterwards the hide-over-the-form styles still apply. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .wa-float {
      animation: wa-pop 400ms var(--ease-out) 1s backwards;
    }
  }
  @keyframes wa-pop {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  @media (min-width: 768px) {
    .wa-float {
      bottom: calc(24px + env(safe-area-inset-bottom));
      inset-inline-end: 24px;
    }
  }
</style>
