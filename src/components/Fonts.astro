---
// Self-hosted Fontsource files, subset by unicode-range so each page only downloads the
// scripts it uses. Only the hero weights for the page language are preloaded.
// Fallback faces are Arial, metric-adjusted to each font so the swap doesn't shift layout
// (Unbounded's size-adjust is tuned so the hero headline wraps the same before and after).
import unboundedLatin500 from '@fontsource/unbounded/files/unbounded-latin-500-normal.woff2?url';
import readexLatin400 from '@fontsource/readex-pro/files/readex-pro-latin-400-normal.woff2?url';
import readexLatin500 from '@fontsource/readex-pro/files/readex-pro-latin-500-normal.woff2?url';
import readexArabic400 from '@fontsource/readex-pro/files/readex-pro-arabic-400-normal.woff2?url';
import readexArabic500 from '@fontsource/readex-pro/files/readex-pro-arabic-500-normal.woff2?url';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const ARABIC =
  'U+0600-06FF,U+0750-077F,U+0870-088E,U+0890-0891,U+0897-08E1,U+08E3-08FF,U+200C-200E,U+2010-2011,U+204F,U+2E41,U+FB50-FDFF,U+FE70-FE74,U+FE76-FEFC';

const face = (family: string, weight: number, url: string, range: string) =>
  `@font-face{font-family:'${family}';font-style:normal;font-display:swap;font-weight:${weight};src:url(${url}) format('woff2');unicode-range:${range}}`;

const css = [
  face('Unbounded', 500, unboundedLatin500, LATIN),
  face('Readex Pro', 400, readexLatin400, LATIN),
  face('Readex Pro', 500, readexLatin500, LATIN),
  face('Readex Pro', 400, readexArabic400, ARABIC),
  face('Readex Pro', 500, readexArabic500, ARABIC),
  `@font-face{font-family:'Unbounded Fallback';src:local('Arial');size-adjust:134.1%;ascent-override:74.2%;descent-override:18.27%;line-gap-override:0%}`,
  `@font-face{font-family:'Readex Pro Fallback';src:local('Arial');size-adjust:109.42%;ascent-override:91.39%;descent-override:22.85%;line-gap-override:0%;unicode-range:${LATIN}}`,
  // Readex Pro's Arabic runs about 1.35x wider than Arial's, so Arabic gets its own fallback face.
  `@font-face{font-family:'Readex Pro Fallback';src:local('Arial');size-adjust:135%;ascent-override:74.07%;descent-override:18.52%;line-gap-override:0%;unicode-range:${ARABIC}}`,
].join('');

// Hero weights: English uses Unbounded 500 (H1) and Readex 400 (subline);
// Arabic uses Readex 500 (H1) and Readex 400 (subline).
const preloads = lang === 'ar' ? [readexArabic500, readexArabic400] : [unboundedLatin500, readexLatin400];
---

{preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<style is:inline set:html={css} />
