---
// Native <details> FAQ, shared by every page. Items come from src/components/home/faq-items.ts.
import Icon from './Icon.astro';

interface Props {
  title: string;
  items: { q: string; a: string }[];
}
const { title, items } = Astro.props;
---

<section class="section-y faq" aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <h2 id="faq-title" data-motion>{title}</h2>
    <div class="faq-list">
      {
        items.map((item) => (
          <details name="faq" data-motion>
            <summary>
              <span>{item.q}</span>
              <Icon name="chevron" size={24} class="faq-icon" />
            </summary>
            <div class="faq-answer">
              <p>{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }
  details {
    border-top: 1px solid var(--color-line);
  }
  details:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding-block: 16px;
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  :global(.faq-icon) {
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.faq-icon) {
      transition: rotate 300ms var(--ease-power3);
    }
  }
  /* The chevron turns 180° while open (and turns back as soon as closing starts). */
  details[open]:not(.is-closing) :global(.faq-icon) {
    rotate: 180deg;
  }
  .faq-answer {
    overflow: hidden;
  }
  details p {
    padding-block-end: 24px;
    max-width: 36rem;
  }
</style>
