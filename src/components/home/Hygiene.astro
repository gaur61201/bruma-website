---
import Icon, { type IconName } from '../Icon.astro';
import ArrowLink from '../ArrowLink.astro';
import { localizedPath, useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hygiene" class="section-y hygiene" aria-labelledby="hygiene-title">
  <div class="wrap hygiene-grid">
    <h2 id="hygiene-title" data-motion>{t.hygiene.h2}</h2>
    <div>
      <ul class="hygiene-list">
      {
        t.hygiene.points.map((point) => (
          <li data-motion>
            <span class="icon-chip icon-chip-raised"><Icon name={point.icon as IconName} size={24} /></span>
            <p>{point.text}</p>
          </li>
        ))
      }
      </ul>
      <ArrowLink href={localizedPath('/hygiene/', lang)} text={t.hygiene.detailLink} class="hygiene-more" />
    </div>
  </div>
</section>

<style>
  .hygiene-grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .hygiene-grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }
  .hygiene-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hygiene-list li {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 20px;
    border-top: 1px solid var(--color-line);
  }
  .hygiene-list li:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .hygiene-grid :global(.hygiene-more) {
    margin-block-start: 16px;
  }

</style>
