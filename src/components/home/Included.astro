---
import IconCard from '../IconCard.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<!-- Desktop: the heading holds its column (sticky) while the six cards run beside it, two by two. -->
<section class="section-y included" aria-labelledby="included-title">
  <div class="wrap included-layout">
    <div class="included-head">
      <h2 id="included-title" data-motion>{t.included.h2}</h2>
    </div>
    <ul class="included-grid">
      {
        t.included.cards.map((card) => (
          <IconCard icon={card.icon} title={card.title} text={card.text} />
        ))
      }
    </ul>
  </div>
</section>

<style>
  .included-layout {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .included-layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 64px;
      align-items: start;
    }
    .included-head {
      position: sticky;
      top: 112px;
    }
  }
  .included-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .included-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .included-grid {
      gap: 24px;
    }
  }
</style>
