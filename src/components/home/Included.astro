---
import IconCard from '../IconCard.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<section class="section-y included" aria-labelledby="included-title">
  <div class="wrap">
    <h2 id="included-title" data-motion>{t.included.h2}</h2>
    <ul class="included-grid">
      {
        t.included.cards.map((card) => (
          <IconCard icon={card.icon} title={card.title} text={card.text} />
        ))
      }
    </ul>
  </div>
</section>

<style>
  .included-grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .included-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .included-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-block-start: 48px;
    }
  }
</style>
