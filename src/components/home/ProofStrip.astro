---
import Icon, { type IconName } from '../Icon.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
const icons: IconName[] = ['timer', 'shield', 'pin'];

// Split out the first number in each item so it can count up from 0 when the strip comes into view.
const parts = (text: string) => {
  const m = text.match(/\d+/);
  if (!m || m.index === undefined) return { before: text, count: null, after: '' };
  return { before: text.slice(0, m.index), count: m[0], after: text.slice(m.index + m[0].length) };
};
---

<section class="proof" aria-label={t.proof.label}>
  <ul class="wrap proof-list">
    {
      t.proof.items.map((item, i) => {
        const p = parts(item);
        return (
          <li data-motion>
            <Icon name={icons[i]} size={28} class="proof-icon" />
            <span>
              {p.before}
              {p.count && (
                <span class="count ltr" data-count={p.count} style={`min-width:${p.count.length}ch`}>
                  {p.count}
                </span>
              )}
              {p.after}
            </span>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .proof-list {
    list-style: none;
    margin-block: 0;
    padding: 0;
    display: grid;
    border-block: 1px solid var(--color-line);
  }
  .proof-list li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-block: 16px;
    font-weight: 500;
  }
  .proof-list li + li {
    border-top: 1px solid var(--color-line);
  }
  :global(.proof-icon) {
    flex-shrink: 0;
  }
  /* Fixed width with tabular digits, so counting up never moves the words around it. */
  .count {
    display: inline-block;
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 768px) {
    .proof-list {
      grid-template-columns: repeat(3, 1fr);
    }
    .proof-list li {
      padding-block: 24px;
      padding-inline: 24px;
    }
    .proof-list li:first-child {
      padding-inline-start: 0;
    }
    .proof-list li + li {
      border-top: 0;
      border-inline-start: 1px solid var(--color-line);
    }
  }
</style>
