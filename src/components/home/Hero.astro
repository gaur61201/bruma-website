---
import Icon from '../Icon.astro';
import HeroVideo from './HeroVideo.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-fade">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero-h1">{t.hero.h1}</h1>
      <!--
        Line-by-line reveal without waiting for GSAP: this runs as soon as the H1 is parsed, groups its
        words into the lines the browser laid out, and CSS keyframes (global.css) slide each line up
        from its mask. When the last line lands, the H1 goes back to plain text. Words are split only
        at spaces, so Arabic letters stay joined. Skipped without JS or under reduced motion.
      -->
      <script is:inline>
        (() => {
          const h = document.currentScript.previousElementSibling;
          if (!document.documentElement.classList.contains('js')) return;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const text = h.textContent.trim();
          const words = text.split(/\s+/);
          h.textContent = '';
          const spans = words.map((word, i) => {
            const s = document.createElement('span');
            s.textContent = word;
            h.append(s);
            if (i < words.length - 1) h.append(' ');
            return s;
          });
          const lines = [];
          let top = -1e9;
          spans.forEach((s) => {
            if (Math.abs(s.offsetTop - top) > 2) {
              lines.push([]);
              top = s.offsetTop;
            }
            lines[lines.length - 1].push(s.textContent);
          });
          h.textContent = '';
          lines.forEach((line, i) => {
            const mask = document.createElement('span');
            mask.className = 'hero-line';
            const inner = document.createElement('span');
            inner.className = 'hero-line-inner';
            inner.style.setProperty('--i', String(i));
            inner.textContent = line.join(' ');
            mask.append(inner);
            h.append(mask);
          });
          let restored = false;
          const restore = () => {
            if (restored) return;
            restored = true;
            h.textContent = text;
          };
          h.lastElementChild.firstElementChild.addEventListener('animationend', restore, { once: true });
          setTimeout(restore, 2000);
        })();
      </script>
      <p class="hero-subline hero-rise" style="--i:0">{t.hero.subline}</p>
      <div class="hero-price hero-rise" style="--i:1">
        <p class="price">{t.hero.price}</p>
        <p class="price-note">{t.hero.priceNote}</p>
      </div>
      <div class="hero-actions">
        <a href="#demo" class="btn btn-primary hero-rise" style="--i:2">
          <span>{t.hero.primaryCta}</span>
          <Icon name="arrow" size={20} class="flip-rtl btn-arrow" />
        </a>
        <a href="#earnings" class="text-link arrow-link hero-rise" style="--i:3">
          <span>{t.hero.secondaryCta}</span>
          <Icon name="arrow" size={20} class="flip-rtl btn-arrow" />
        </a>
      </div>
    </div>
    <div class="hero-media hero-media-reveal">
      <HeroVideo lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 24px 56px;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: 48px 96px;
    }
  }
  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 64px;
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hero-copy h1 {
    max-width: 12em;
  }
  .hero-copy h1:lang(ar) {
    max-width: 14em;
  }
  .hero-subline {
    max-width: 32rem;
  }
  .hero-price {
    margin-block-start: 8px;
    padding-block-start: 16px;
    border-top: 1px solid var(--color-line);
  }
  .price {
    font-weight: 500;
    font-size: calc(var(--fs-h3) * var(--script-scale));
    line-height: var(--heading-leading);
  }
  .price-note {
    margin-block-start: 8px;
    font-size: calc(var(--fs-small) * var(--script-scale));
    color: var(--color-stone);
    max-width: 32rem;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-block-start: 8px;
  }
  .hero-actions .btn {
    width: 100%;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 24px;
    }
    .hero-actions .btn {
      width: auto;
    }
  }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .hero-media {
    width: 100%;
    max-width: 480px;
    justify-self: center;
  }
  @media (min-width: 1024px) {
    .hero-media {
      max-width: none;
    }
  }
</style>
