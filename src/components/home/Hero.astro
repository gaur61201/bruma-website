---
import Icon from '../Icon.astro';
import HeroVideo from './HeroVideo.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-fade">{t.hero.eyebrow}</p>
      <!-- Print-head wipe: CSS only (global.css), so the LCP text never waits for GSAP. -->
      <h1 id="hero-title" class="print-wipe">
        <span class="print-wipe-text">{t.hero.h1}</span>
        <span class="print-wipe-layer" aria-hidden="true">
          {
            [0, 1, 2, 3].map((i) => (
              <>
                <span class="print-wipe-cover" style={`--i:${i}`} />
                <span class="wipe-bar" style={`--i:${i}`} />
              </>
            ))
          }
        </span>
      </h1>
      <p class="hero-subline hero-rise" style="--i:0">{t.hero.subline}</p>
      <div class="hero-price hero-rise" style="--i:1">
        <p class="price">{t.hero.price}</p>
        <p class="price-note">{t.hero.priceNote}</p>
      </div>
      <div class="hero-actions">
        <a href="#demo" class="btn btn-primary hero-rise" style="--i:2">
          <span>{t.hero.primaryCta}</span>
          <Icon name="arrow" size={20} class="flip-rtl btn-arrow" />
        </a>
        <a href="#earnings" class="text-link arrow-link hero-rise" style="--i:3">
          <span>{t.hero.secondaryCta}</span>
          <Icon name="arrow" size={20} class="flip-rtl btn-arrow" />
        </a>
      </div>
    </div>
    <div class="hero-media hero-media-reveal">
      <HeroVideo lang={lang} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 24px 56px;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: 48px 96px;
    }
  }
  .hero-grid {
    display: grid;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 7fr 5fr;
      gap: 64px;
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hero-copy h1 {
    max-width: 12em;
  }
  .hero-copy h1:lang(ar) {
    max-width: 14em;
  }
  .hero-subline {
    max-width: 32rem;
  }
  .hero-price {
    margin-block-start: 8px;
    padding-block-start: 16px;
    border-top: 1px solid var(--color-line);
  }
  .price {
    font-weight: 500;
    font-size: calc(var(--fs-h3) * var(--script-scale));
    line-height: var(--heading-leading);
  }
  .price-note {
    margin-block-start: 8px;
    font-size: calc(var(--fs-small) * var(--script-scale));
    color: var(--color-stone);
    max-width: 32rem;
  }
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    margin-block-start: 8px;
  }
  .hero-actions .btn {
    width: 100%;
  }
  @media (min-width: 640px) {
    .hero-actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 24px;
    }
    .hero-actions .btn {
      width: auto;
    }
  }
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
  }
  .hero-media {
    width: 100%;
    max-width: 480px;
    justify-self: center;
  }
  @media (min-width: 1024px) {
    .hero-media {
      max-width: none;
    }
  }
</style>
