---
import { calculatorRanges, config } from '../../config';
import { useTranslations, type Lang } from '../../i18n';
import { ar as arForms, arCount } from '../../i18n/plural';
import { estimate } from '../../scripts/calculator-math';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = config.calculator;
const r = calculatorRanges;

// Server-render the default estimate so the first paint is already correct.
const initial = estimate({
  price: c.pricePerSet,
  sets: c.setsPerDay,
  days: c.workDays,
  monthly: true,
  plan: config.planMonthlyKwd,
  cartridge: c.cartridgeCostPerSet,
});
const fmt = (n: number) => `${n < 0 ? '−' : ''}${Math.abs(Math.round(n)).toLocaleString('en-US')}`;
const breakEvenText = (n: number) => {
  if (n === 1) return t.calc.breakEvenOne;
  return t.calc.breakEven.replace('{n}', lang === 'ar' ? arCount(n, arForms.sets) : String(n));
};

const inputs = [
  { id: 'price', label: t.calc.priceLabel, value: c.pricePerSet, ...r.price, decimal: true },
  { id: 'sets', label: t.calc.setsLabel, value: c.setsPerDay, ...r.sets, decimal: false },
  { id: 'days', label: t.calc.daysLabel, value: c.workDays, ...r.days, decimal: false },
];
const outputs = [
  { key: 'revenue', label: t.calc.revenue, value: initial.revenue },
  { key: 'running', label: t.calc.running, value: initial.running },
  { key: 'left', label: t.calc.left, value: initial.left },
];

const settings = {
  lang,
  plan: config.planMonthlyKwd,
  cartridge: c.cartridgeCostPerSet,
  breakEven: t.calc.breakEven,
  breakEvenOne: t.calc.breakEvenOne,
  underCost: t.calc.underCost,
};
---

<section id="earnings" class="on-carbon section-y" aria-labelledby="earnings-title">
  <div class="wrap">
    <div class="calc-head reveal">
      <h2 id="earnings-title">{t.calc.h2}</h2>
      <p class="calc-intro calc-js-only">{t.calc.intro}</p>
    </div>

    <p class="calc-static">{t.calc.staticExample}</p>

    <form class="calc calc-js-only reveal" data-calc data-settings={JSON.stringify(settings)} novalidate>
      <div class="calc-inputs">
        <fieldset class="mode">
          <legend class="calc-label">{t.calc.modeLegend}</legend>
          <div class="mode-options">
            <label class="mode-option">
              <input type="radio" name="mode" value="monthly" checked />
              <span>{t.calc.monthly}</span>
            </label>
            <label class="mode-option">
              <input type="radio" name="mode" value="upfront" />
              <span>{t.calc.upfront}</span>
            </label>
          </div>
        </fieldset>

        {
          inputs.map((input) => (
            <div class="calc-field">
              <label class="calc-label" for={`calc-${input.id}`} id={`calc-${input.id}-label`}>
                {input.label}
              </label>
              <div class="calc-row">
                <input
                  type="range"
                  class="calc-range"
                  min={input.min}
                  max={input.max}
                  step={input.step}
                  value={input.value}
                  aria-labelledby={`calc-${input.id}-label`}
                  data-range={input.id}
                />
                <input
                  type="number"
                  class="calc-number"
                  id={`calc-${input.id}`}
                  name={input.id}
                  min={input.min}
                  max={input.max}
                  step={input.step}
                  value={input.value}
                  inputmode={input.decimal ? 'decimal' : 'numeric'}
                  data-number={input.id}
                />
              </div>
            </div>
          ))
        }
      </div>

      <div class="calc-results" aria-live="polite" aria-atomic="true">
        <p class="sr-only">{t.calc.resultsLabel}</p>
        <dl>
          {
            outputs.map((o) => (
              <div class:list={['result', { 'result-main': o.key === 'left' }]}>
                <dt>{o.label}</dt>
                <dd>
                  {lang === 'ar' ? (
                    <>
                      <span class="ltr" data-out={o.key}>{fmt(o.value)}</span> <span>د.ك</span>
                    </>
                  ) : (
                    <>
                      <span>KWD</span> <span class="ltr" data-out={o.key}>{fmt(o.value)}</span>
                    </>
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="break-even" data-out="breakEven">
          {initial.breakEven === null ? t.calc.underCost : breakEvenText(initial.breakEven)}
        </p>
      </div>
    </form>

    <p class="calc-note">{t.calc.note}</p>
  </div>
</section>

<script>
  import { initCalculator } from '../../scripts/calculator';
  document.querySelectorAll<HTMLFormElement>('[data-calc]').forEach(initCalculator);
</script>

<style>
  .calc-head {
    max-width: 720px;
  }
  .calc-intro {
    margin-block-start: 16px;
  }
  .calc-static {
    margin-block-start: 24px;
    max-width: 720px;
  }
  :global(.js) .calc-static {
    display: none;
  }
  :global(.no-js) .calc-js-only {
    display: none;
  }

  .calc {
    display: grid;
    gap: 40px;
    margin-block-start: 40px;
  }
  @media (min-width: 1024px) {
    .calc {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
  }
  .calc-inputs {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .calc-label {
    display: block;
    margin-block-end: 8px;
    font-weight: 500;
    color: var(--color-mist);
    font-size: calc(var(--fs-small) * var(--script-scale));
  }

  .mode {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .mode-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .mode-option {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding-inline: 16px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }
  .mode-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .mode-option:has(input:checked) {
    background: var(--color-bone);
    color: var(--color-carbon);
    border-color: var(--color-bone);
  }
  .mode-option:has(input:focus-visible) {
    outline: 3px solid var(--color-mist);
    outline-offset: 3px;
  }

  .calc-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .calc-number {
    width: 96px;
    min-height: 48px;
    padding-inline: 12px;
    border: 0;
    border-radius: var(--radius-input);
    background: var(--color-white);
    color: var(--color-carbon);
    font: inherit;
    font-weight: 500;
    text-align: center;
  }

  /* Slider: a line-coloured track with a mist thumb. */
  .calc-range {
    flex: 1;
    min-width: 0;
    height: 44px;
    margin: 0;
    background: transparent;
    appearance: none;
    -webkit-appearance: none;
    cursor: pointer;
  }
  .calc-range::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 2px;
    background: var(--color-line);
  }
  .calc-range::-moz-range-track {
    height: 4px;
    border-radius: 2px;
    background: var(--color-line);
  }
  .calc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 28px;
    height: 28px;
    margin-top: -12px;
    border-radius: 50%;
    background: var(--color-mist);
    border: 3px solid var(--color-carbon);
  }
  .calc-range::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-mist);
    border: 3px solid var(--color-carbon);
  }
  .calc-range:focus-visible {
    outline-offset: 0;
  }

  .calc-results dl {
    margin: 0;
    display: grid;
    gap: 24px;
  }
  .result {
    padding-block-end: 24px;
    border-bottom: 1px solid var(--color-line);
  }
  .result dt {
    font-size: calc(var(--fs-small) * var(--script-scale));
    font-weight: 500;
  }
  .result dd {
    margin: 8px 0 0;
    color: var(--color-mist);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: calc(var(--fs-stat) * var(--script-scale));
    line-height: 1.1;
  }
  .result dd:lang(ar) {
    font-family: var(--font-body);
  }
  .result dd span:not(.ltr) {
    font-size: 0.5em;
  }
  .result-main dt {
    font-size: calc(var(--fs-body) * var(--script-scale));
  }
  .result-main dd {
    font-size: calc(var(--fs-stat) * var(--script-scale) * 1.25);
  }
  .break-even {
    margin-block-start: 24px;
    font-weight: 500;
  }
  .calc-note {
    margin-block-start: 40px;
    max-width: 640px;
    font-size: calc(var(--fs-small) * var(--script-scale));
  }
</style>
