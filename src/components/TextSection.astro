---
// A content section for the inner pages: heading in one column, content in the other on desktop,
// stacked on mobile. Optional paragraphs, a divided list and a row of chips are rendered from props;
// anything else goes in the slot after them. Motion comes from the generic data-reveal hooks in motion.ts.
interface Props {
  /** id for the h2 (the section is labelled by it). */
  id: string;
  title: string;
  paragraphs?: string[];
  list?: string[];
  /** Short items (place names) shown as a wrapping row of chips instead of a divided list. */
  chips?: string[];
  /** Optional id on the section itself, for in-page links. */
  anchor?: string;
  /** Heading above full-width content (for wide content: step cards, tables), instead of two columns. */
  stacked?: boolean;
}
const { id, title, paragraphs = [], list = [], chips = [], anchor, stacked = false } = Astro.props;
---

<section id={anchor} class="text-section" aria-labelledby={id} data-reveal-section>
  <div class:list={['wrap', 'text-section-grid', { stacked }]}>
    <h2 id={id} data-motion data-reveal="heading">{title}</h2>
    <div class="text-section-body">
      {paragraphs.map((text) => <p data-motion data-reveal="fade">{text}</p>)}
      {
        list.length > 0 && (
          <ul class="divided-list">
            {list.map((item) => (
              <li data-motion data-reveal="item">
                {item}
              </li>
            ))}
          </ul>
        )
      }
      {
        chips.length > 0 && (
          <ul class="chip-list">
            {chips.map((item) => (
              <li class="chip" data-motion data-reveal="item">
                {item}
              </li>
            ))}
          </ul>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  /* Text sections run tighter than the composed sections, divided by a rule inside the content
     width rather than a full-bleed line. */
  .text-section {
    padding-block: 56px;
  }
  @media (min-width: 1024px) {
    .text-section {
      padding-block: 88px;
    }
  }
  .text-section + .text-section .text-section-grid {
    padding-block-start: 56px;
    border-top: 1px solid var(--color-line);
  }
  .text-section + .text-section {
    padding-block-start: 0;
  }
  @media (min-width: 1024px) {
    .text-section + .text-section .text-section-grid {
      padding-block-start: 88px;
    }
  }
  .text-section-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 1024px) {
    .text-section-grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }
  .text-section-grid.stacked {
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .text-section-grid.stacked {
      gap: 48px;
    }
  }
  .stacked .text-section-body {
    max-width: none;
  }
  .text-section-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 40rem;
  }
  .divided-list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }
  .divided-list li {
    padding-block: 16px;
    border-top: 1px solid var(--color-line);
  }
  .divided-list li:last-child {
    border-bottom: 1px solid var(--color-line);
  }
  .chip-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 20px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
    font-weight: 500;
  }
</style>
