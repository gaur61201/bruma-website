---
// "Step by step": the homepage's four steps in detail. Each step is a wide photo with a white copy
// card overlapping its edge, alternating sides on desktop (the grid mirrors in Arabic); on mobile the
// card overlaps the bottom of the photo.
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const s = useTranslations(Astro.props.lang).printer.steps;
---

<section id="how-it-works" class="section-y step-detail" aria-labelledby="step-detail-title" data-reveal-section>
  <div class="wrap">
    <h2 id="step-detail-title" data-motion data-reveal="heading">{s.h2}</h2>
    <ol class="step-rows">
      {
        s.items.map((step, i) => (
          <li class:list={['step-row', { 'step-row-flip': i % 2 === 1 }]}>
            <PhotoPlaceholder caption={step.photo} ratio="4 / 3" />
            <div class="step-copy card" data-motion data-reveal="item">
              <span class="step-index ltr" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="step-footnote" data-motion data-reveal="fade">{s.footnote}</p>
  </div>
</section>

<style>
  .step-rows {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 56px;
  }
  .step-row {
    display: grid;
    align-items: center;
  }
  .step-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin: -48px 16px 0;
    padding: 28px 24px;
    box-shadow: var(--shadow-card-hover);
  }
  @media (min-width: 1024px) {
    .step-rows {
      gap: 96px;
      margin-block-start: 64px;
    }
    .step-row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
    .step-copy {
      margin: 0;
      margin-inline-start: -96px;
      padding: 40px;
    }
    /* Every other step: the photo on the other side, the card overlapping it from there. */
    .step-row-flip {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .step-row-flip :global(.photo) {
      order: 2;
    }
    .step-row-flip .step-copy {
      margin-inline: 0 -96px;
    }
  }
  .step-index {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    margin-block-end: 12px;
    border-radius: 50%;
    background: var(--color-carbon);
    color: var(--color-bone);
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: calc(var(--fs-body) * var(--script-scale));
  }
  .step-index:lang(ar) {
    font-family: var(--font-body);
  }
  .step-footnote {
    margin-block-start: 56px;
    font-weight: 500;
  }
</style>
