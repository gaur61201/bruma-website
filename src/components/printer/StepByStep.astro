---
// "Step by step": the homepage's four steps in detail. Photo and text side by side on desktop,
// alternating sides (the grid mirrors in Arabic); stacked on mobile.
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const s = useTranslations(Astro.props.lang).printer.steps;
---

<section class="section-y step-detail" aria-labelledby="step-detail-title" data-reveal-section>
  <div class="wrap">
    <h2 id="step-detail-title" data-motion data-reveal="heading">{s.h2}</h2>
    <ol class="step-rows">
      {
        s.items.map((step, i) => (
          <li class:list={['step-row', { 'step-row-flip': i % 2 === 1 }]}>
            <PhotoPlaceholder caption={step.photo} ratio="4 / 3" />
            <div class="step-copy" data-motion data-reveal="item">
              <span class="step-index ltr" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="step-footnote" data-motion data-reveal="fade">{s.footnote}</p>
  </div>
</section>

<style>
  .step-detail {
    border-top: 1px solid var(--color-line);
  }
  .step-rows {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 48px;
  }
  .step-row {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .step-rows {
      gap: 64px;
      margin-block-start: 48px;
    }
    .step-row {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
    .step-row-flip :global(.photo) {
      order: 2;
    }
  }
  .step-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    max-width: 32rem;
  }
  .step-index {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-block-end: 8px;
    border-radius: 50%;
    background: var(--color-carbon);
    color: var(--color-bone);
    font-weight: 500;
    font-size: calc(var(--fs-small) * var(--script-scale));
  }
  .step-footnote {
    margin-block-start: 48px;
    font-weight: 500;
  }
</style>
