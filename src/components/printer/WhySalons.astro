---
// "Why salons add it": three white cards (the shared IconCard).
import IconCard from '../IconCard.astro';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const w = useTranslations(Astro.props.lang).printer.why;
---

<section class="section-y why" aria-labelledby="why-title" data-reveal-section>
  <div class="wrap">
    <h2 id="why-title" data-motion data-reveal="heading">{w.h2}</h2>
    <ul class="why-grid">
      {w.cards.map((card) => <IconCard icon={card.icon} title={card.title} text={card.text} reveal />)}
    </ul>
  </div>
</section>

<style>
  .why {
    border-top: 1px solid var(--color-line);
  }
  .why-grid {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      margin-block-start: 48px;
    }
  }
</style>
