---
// Specifications (#specs): a two-column table built from printerSpecs in src/config.ts, then
// "What's in the box" from boxContents. The printer page's one extra carbon band: a spec sheet,
// labels in mist, values in bone.
import { boxContents, visiblePrinterSpecs } from '../../config';
import { useTranslations, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sp = useTranslations(lang).printer.specs;
const rows = visiblePrinterSpecs();
---

<section id="specs" class="on-carbon section-y specs" aria-labelledby="specs-title" data-reveal-section>
  <div class="wrap specs-grid">
    <h2 id="specs-title" data-motion data-reveal="heading">{sp.h2}</h2>
    <div>
      <div class="specs-card" data-motion data-reveal="item">
        <table class="specs-table">
          <caption class="sr-only">{sp.caption}</caption>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th scope="row">{sp.labels[row.label]}</th>
                  <td>{row.value[lang]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="specs-note" data-motion data-reveal="fade">{sp.note}</p>
      <h3 id="box-title" class="box-title" data-motion data-reveal="fade">{sp.boxTitle}</h3>
      <div class="specs-card" data-motion data-reveal="item">
        <ul class="box-list" aria-labelledby="box-title">
          {boxContents.map((b) => <li>{b.item[lang]}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .specs-grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .specs-grid {
      grid-template-columns: 5fr 7fr;
      gap: 64px;
      align-items: start;
    }
  }
  /* Rules on carbon: bone at low strength. */
  .specs-card {
    border-block: 1px solid rgb(243 239 232 / 0.16);
  }
  .specs-table {
    width: 100%;
    border-collapse: collapse;
  }
  .specs-table tr + tr {
    border-top: 1px solid rgb(243 239 232 / 0.16);
  }
  .specs-table th,
  .specs-table td {
    padding-block: 20px;
    text-align: start;
    vertical-align: top;
  }
  .specs-table th {
    width: 40%;
    padding-inline-end: 16px;
    font-weight: 500;
    color: var(--color-mist);
    font-size: calc(var(--fs-small) * var(--script-scale));
    line-height: var(--body-leading);
  }
  .specs-table td {
    font-family: var(--font-body);
    font-weight: 500;
  }
  .specs-note {
    margin-block-start: 16px;
    font-size: calc(var(--fs-small) * var(--script-scale));
  }
  .box-title {
    margin-block: 56px 16px;
  }
  .box-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .box-list li {
    padding-block: 16px;
    font-weight: 500;
  }
  .box-list li + li {
    border-top: 1px solid rgb(243 239 232 / 0.16);
  }
</style>
