---
// Inline SVG outline icons on a 24px grid, drawn for this site. Decorative: hidden from screen readers.
// The WhatsApp glyph is the official mark (from Simple Icons, CC0) and is filled, not outlined.
const icons = {
  arrow: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
  menu: '<path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>',
  close: '<path d="m6 6 12 12"/><path d="M18 6 6 18"/>',
  plus: '<path d="M12 5v14"/><path d="M5 12h14"/>',
