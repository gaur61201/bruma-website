---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import LangSwitch from './LangSwitch.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n';
// Carbon letters: the wordmark for light backgrounds.
import wordmarkOnLight from '../assets/brand/bruma-air-wordmark-light.png';

interface Props {
  lang: Lang;
  altHref?: string;
}
const { lang, altHref } = Astro.props;
const t = useTranslations(lang);
const home = localizedPath('/', lang);
const onHome = Astro.url.pathname === home;
// Until their own pages exist, nav items point at homepage sections.
const section = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);

const links = [
  { href: section('how-it-works'), label: t.nav.printer },
  { href: section('gallery'), label: t.nav.gallery },
  { href: section('ways-to-own'), label: t.nav.waysToOwn },
  { href: section('hygiene'), label: t.nav.hygiene },
];
const demoHref = section('demo');
---

<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a href={home} class="logo-link">
      <Image src={wordmarkOnLight} alt={t.nav.homeLabel} height={40} densities={[1, 2]} format="webp" quality={90} loading="eager" class="logo" />
    </a>

    <nav aria-label={t.nav.label} class="desktop-nav">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LangSwitch lang={lang} altHref={altHref} />
      <a href={demoHref} class="btn btn-primary btn-small desktop-only">{t.nav.bookDemo}</a>
      <button type="button" class="menu-button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t.nav.menuOpen} data-menu-open>
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<dialog id="mobile-menu" class="mobile-menu" aria-label={t.nav.menuTitle} data-menu>
  <div class="wrap menu-top">
    <a href={home} class="logo-link" data-menu-link>
      <Image src={wordmarkOnLight} alt={t.nav.homeLabel} height={40} densities={[1, 2]} format="webp" quality={90} class="logo" />
    </a>
    <button type="button" class="menu-button" aria-label={t.nav.menuClose} data-menu-close>
      <Icon name="close" />
    </button>
  </div>
  <nav aria-label={t.nav.label} class="wrap menu-nav">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-menu-link>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={demoHref} class="btn btn-primary menu-cta" data-menu-link>{t.nav.bookDemo}</a>
  </nav>
</dialog>

<script>
  // Sticky header: transparent at the top, bone with a line border once the page scrolls.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const sentinel = document.querySelector('[data-scroll-sentinel]');
  if (header && sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => {
      header.toggleAttribute('data-scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }

  // Mobile menu: a modal <dialog> (Esc closes it natively); Tab is kept inside while open.
  const dialog = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (dialog && openBtn) {
    const focusables = () =>
      Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter((el) => el.offsetParent !== null);

    openBtn.addEventListener('click', () => {
      dialog.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
      dialog.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    });
    dialog.addEventListener('close', () => openBtn.setAttribute('aria-expanded', 'false'));
    dialog.querySelector('[data-menu-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => dialog.close()));
    dialog.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
    // Close the menu if the viewport grows to desktop while it's open.
    matchMedia('(min-width: 1024px)').addEventListener('change', (mq) => {
      if (mq.matches && dialog.open) dialog.close();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }
  .site-header[data-scrolled] {
    background: var(--color-bone);
    border-bottom-color: var(--color-line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  @media (min-width: 1024px) {
    .header-inner {
      min-height: 80px;
    }
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }
  .logo {
    height: 36px;
    width: auto;
    /* The logo file has a transparent margin; pull it back so the letters align with the gutter. */
    margin-inline-start: -7px;
  }
  @media (min-width: 1024px) {
    .logo {
      height: 40px;
      margin-inline-start: -8px;
    }
  }

  .desktop-nav {
    display: none;
  }
  .desktop-nav ul {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 12px;
    font-weight: 500;
    font-size: calc(var(--fs-small) * var(--script-scale));
    text-decoration: none;
    text-underline-offset: 6px;
  }
  .desktop-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .desktop-only {
    display: none;
  }
  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-inline-end: -12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-carbon);
    cursor: pointer;
  }
  .menu-button:hover {
    background: var(--color-white);
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }
    .desktop-only {
      display: inline-flex;
    }
    .site-header .menu-button {
      display: none;
    }
    .header-actions {
      gap: 16px;
    }
  }

  /* Full-screen bone panel. */
  .mobile-menu {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bone);
    color: var(--color-carbon);
  }
  .mobile-menu[open] {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu::backdrop {
    background: var(--color-bone);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mobile-menu[open] {
      animation: menu-in 200ms var(--ease-out);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
  }
  .menu-nav {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 24px 48px;
  }
  .menu-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-nav li + li {
    border-top: 1px solid var(--color-line);
  }
  .menu-nav ul a {
    display: flex;
    align-items: center;
    min-height: 64px;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: calc(var(--fs-h3) * var(--script-scale));
    text-decoration: none;
  }
  .menu-nav ul a:lang(ar) {
    font-family: var(--font-body);
  }
  .menu-cta {
    width: 100%;
  }
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>
